#include <PID_v1.h>
#include <Wire.h>
#include <EEPROM.h>
#include <MPU6050_tockn.h>

unsigned long previousMillis = 0;
unsigned long currentMillis = 0;
unsigned long previousSaveMillis = 0;

float temperature;
float savedTemp;
float Ax, Ay, Az;
float Gx, Gy, Gz;

double Input = 0;
double Setpoint = 0;
double Output = 0;
double Kp = 2.0, Ki = 0.0, Kd = 0.0;

PID myPID(&Input, &Output, &Setpoint, Kp, Ki, Kd, DIRECT);
MPU6050 mpu6050(Wire);

unsigned long timer = 0;
float systemSpeed = 0;
unsigned long pidCount = 0;

void setup() {
  Serial.begin(9600);
  Wire.begin();
  mpu6050.begin();
  mpu6050.calcGyroOffsets(true);

  myPID.SetMode(AUTOMATIC);
  myPID.SetOutputLimits(-100, 100);
  myPID.SetSampleTime(20);

  EEPROM.get(0, savedTemp);
  Serial.print("temperature is now saved : ");
  Serial.println(savedTemp);
}

void loop() {

  mpu6050.update();

  Ax = mpu6050.getAccX();
  Ay = mpu6050.getAccY();
  Az = mpu6050.getAccZ();

  Gx = mpu6050.getGyroX();
  Gy = mpu6050.getGyroY();
  Gz = mpu6050.getGyroZ();

  Input = atan2(-Ax, sqrt(Ay * Ay + Az * Az)) * 180.0 / PI; // Calculate pitch angle from accelerometer done py ai

  if (myPID.Compute()) {
    pidCount++;
  }

  currentMillis = millis();

  if (currentMillis - timer >= 1000) {

    Serial.print("temp : ");
    Serial.println(mpu6050.getTemp());

    Serial.print("accX : ");
    Serial.print(mpu6050.getAccX());
    Serial.print("\taccY : ");
    Serial.print(mpu6050.getAccY());
    Serial.print("\taccZ : ");
    Serial.println(mpu6050.getAccZ());

    Serial.print("gyroX : ");
    Serial.print(mpu6050.getGyroX());
    Serial.print("\tgyroY : ");
    Serial.print(mpu6050.getGyroY());
    Serial.print("\tgyroZ : ");
    Serial.println(mpu6050.getGyroZ());

    Serial.print("accAngleX : ");
    Serial.print(mpu6050.getAccAngleX());
    Serial.print("\taccAngleY : ");
    Serial.println(mpu6050.getAccAngleY());

    Serial.print("gyroAngleX : ");
    Serial.print(mpu6050.getGyroAngleX());
    Serial.print("\tgyroAngleY : ");
    Serial.print(mpu6050.getGyroAngleY());
    Serial.print("\tgyroAngleZ : ");
    Serial.println(mpu6050.getGyroAngleZ());

    Serial.print("angleX : ");
    Serial.print(mpu6050.getAngleX());
    Serial.print("\tangleY : ");
    Serial.print(mpu6050.getAngleY());
    Serial.print("\tangleZ : ");
    Serial.println(mpu6050.getAngleZ());

    timer = currentMillis;

    Serial.print("Input:");
    Serial.print(Input);
    Serial.print(" Setpoint:");
    Serial.print(Setpoint);
    Serial.print(" Output:");
    Serial.println(Output);

    double error = Setpoint - Input; // done by ai
    Serial.print(" Error:");
    Serial.println(error);

    systemSpeed = pidCount;
    Serial.print("System Speed: ");
    Serial.print(systemSpeed);
    Serial.println(" Hz");

    pidCount = 0;
  }

  if (currentMillis - previousSaveMillis >= 60000) {
    previousSaveMillis = currentMillis;

    temperature = mpu6050.getTemp();

    EEPROM.put(0, temperature);

    Serial.print("Stored Temperature: ");
    Serial.println(temperature);

    delay(60000);
  }
}
